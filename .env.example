# --- API ---
API_PORT=4000
DATABASE_URL=postgres://stego:stego@localhost:5432/stego
# The API refuses to start with this placeholder. Generate one: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Origin the browser app is served from. State-changing requests must come from it (CSRF check);
# https here also marks auth cookies Secure. Use http://localhost:8080 when browsing through Caddy.
APP_ORIGIN=http://localhost:3000
# Comma-separated peers whose X-Client-IP header the API believes: the Next server, which forwards the
# header Caddy (infra/, http://localhost:8080) sets. Without Caddy every request has the same client IP
# and per-IP rate limits act as one shared limit; that is fine for plain :3000 development. Over :3000
# a browser could also send its own X-Client-IP, which only matters when testing rate limits.
TRUSTED_PROXIES=127.0.0.1,::1

# --- Redis (rate limits, short-lived state) ---
# Local only. Compose reads REDIS_PASSWORD, the API reads REDIS_URL. Pick your own value.
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# --- Object storage (RustFS locally, Cloudflare R2 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=stego
S3_ACCESS_KEY_ID=stego
S3_SECRET_ACCESS_KEY=stego-secret

# --- Worker (uses DATABASE_URL above) ---
WORKER_POLL_INTERVAL_MS=1000
WORKER_JOB_TIMEOUT_MS=600000

# --- Web ---
API_URL=http://localhost:4000
