# --- API ---
API_PORT=4000
DATABASE_URL=postgres://stego:stego@localhost:5432/stego
JWT_SECRET=change-me-to-a-long-random-string

# --- Redis (rate limits, short-lived state) ---
# Local only. Compose reads REDIS_PASSWORD, the API reads REDIS_URL. Pick your own value.
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# --- Object storage (RustFS locally, Cloudflare R2 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=stego
S3_ACCESS_KEY_ID=stego
S3_SECRET_ACCESS_KEY=stego-secret

# --- Worker (uses DATABASE_URL above) ---
WORKER_POLL_INTERVAL_MS=1000
WORKER_JOB_TIMEOUT_MS=600000

# --- Web ---
API_URL=http://localhost:4000
